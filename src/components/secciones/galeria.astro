---
// Galería en banda negra: titular arriba y mosaico de borde a borde de la ventana, sin márgenes (3 px entre fotos).
// La primera foto es grande (2×2) y el resto cuadradas; 2 columnas en móvil y 4 desde tableta.
// Fotos en site.yaml → secciones.<id>.galeria (lista de rutas). Sin fotos, solo el titular.
import { seccion } from '../../data/site';
import { altGaleria } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id} fondo="negro" contenedor={false} class:list={[{ '!pb-0': s.galeria.length > 0 }]}>
      <div class="contenedor">
        <Titular alinear="partido" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      </div>
      {s.galeria.length > 0 && (
        <ul class="mosaico">
          {s.galeria.map((foto, i) => (
            <li>
              <Imagen src={foto} alt={altGaleria(i)} ancho={i === 0 ? 1400 : 800} alto={i === 0 ? 1400 : 800} />
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
