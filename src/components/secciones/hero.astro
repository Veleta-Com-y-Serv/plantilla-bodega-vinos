---
// Portada a pantalla completa: foto a sangre (viñedo) con velo oscuro, marco dorado fino de etiqueta (desde tableta),
// título enorme en serif, párrafo corto y dos botones. `items`: ficha de la bodega en una columna con filetes a la
// derecha (debajo en móvil). Sin `cta`, el primer botón llama por teléfono; sin `cta_secundario`, el segundo lleva al mapa.
// La cabecera es transparente encima (ver Header.astro).
import { seccion, site, tel, mapa, externo } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const principal = s?.cta?.url ? s.cta : c.telefono ? { texto: c.telefono, url: tel(c.telefono) } : null;
const secundario = s?.cta_secundario?.url ? s.cta_secundario : c.direccion ? { texto: 'Cómo llegar', url: mapa(c.direccion) } : null;
const fuera = (u: string) => (externo(u) ? { rel: 'noopener', target: '_blank' } : {});
const ficha = s ? s.items.filter((it) => it && it.titulo) : [];
---

{
  s && (
    <section id={id} class="portada">
      <div class="portada-fondo">
        <Imagen src={s.imagen} alt={altHero()} ancho={1920} alto={1080} prioridad={primera} class="h-full w-full object-cover" />
      </div>
      <div class="portada-contenido">
        <div>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          <h1 class="portada-titulo">{s.titulo || site.nombre}</h1>
          {s.texto && <p class="portada-texto">{s.texto}</p>}
          {(principal || secundario) && (
            <div class="mt-10 flex flex-wrap gap-3">
              {principal && <a class="btn" href={principal.url} {...fuera(principal.url)}>{principal.texto}</a>}
              {secundario && <a class="btn-sec" href={secundario.url} {...fuera(secundario.url)}>{secundario.texto}</a>}
            </div>
          )}
        </div>
        {ficha.length > 0 && (
          <ul class="portada-ficha">
            {ficha.map((it) => (
              <li>{it.titulo}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
