---
// Opiniones, en banda burdeos: la primera como cita enorme centrada con comilla dorada y el resto en columnas
// con filete dorado encima. `testimonios` [{texto, autor, nota}]; `nota` opcional (de dónde viene, p. ej. «Google»).
// Sin estrellas ni puntuaciones: solo lo que dice el cliente. Sin opiniones, la sección no se pinta.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const [primera, ...resto] = s ? s.testimonios : [];
---

{
  s && primera && (
    <Seccion id={Astro.props.id} fondo="vino">
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <figure class="opinion-grande">
        <blockquote>{primera.texto}</blockquote>
        {(primera.autor || primera.nota) && (
          <figcaption class="opinion-autor">
            {primera.autor && <span>{primera.autor}</span>}
            {primera.nota && <span class="opinion-nota">{primera.nota}</span>}
          </figcaption>
        )}
      </figure>
      {resto.length > 0 && (
        <ul class:list={['opiniones-resto', { 'opiniones-resto--3': resto.length % 3 === 0 }]}>
          {resto.map((t) => (
            <li>
              <figure>
                <blockquote>{t.texto}</blockquote>
                {(t.autor || t.nota) && (
                  <figcaption class="opinion-autor">
                    {t.autor && <span>{t.autor}</span>}
                    {t.nota && <span class="opinion-nota">{t.nota}</span>}
                  </figcaption>
                )}
              </figure>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
