---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con todos los campos en el cuerpo.
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// `visita`: añade día y número de personas y, si se pasan `opciones` (las visitas de enoturismo), un desplegable
// para elegir visita (con «Solo quiero comprar vino» y «Otra consulta»).
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; visita?: boolean; opciones?: string[]; prefijo?: string }
const {
  boton = 'Enviar mensaje',
  class: clase = '',
  asunto = `Consulta desde la web de ${site.nombre}`,
  visita = false,
  opciones = [],
  prefijo = 'f',
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const id = (c: string) => `${prefijo}-${c}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="formulario-fila">
    <div class="campo">
      <label for={id('nombre')}>Nombre</label>
      <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for={id('contacto')}>Email o teléfono</label>
      <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
    </div>
  </div>
  {
    visita && opciones.length > 0 && (
      <div class="campo">
        <label for={id('visita')}>Qué te interesa</label>
        <select id={id('visita')} name="visita">
          {opciones.map((o) => <option>{o}</option>)}
          <option>Solo quiero comprar vino</option>
          <option>Otra consulta</option>
        </select>
      </div>
    )
  }
  {
    visita && (
      <div class="formulario-fila formulario-fila--3">
        <div class="campo">
          <label for={id('fecha')}>Día que prefieres</label>
          <input id={id('fecha')} name="fecha" type="date" />
        </div>
        <div class="campo">
          <label for={id('personas')}>Personas</label>
          <input id={id('personas')} name="personas" type="number" min="1" max="60" inputmode="numeric" />
        </div>
      </div>
    )
  }
  <div class="campo">
    <label for={id('mensaje')}>{visita ? 'Mensaje (idioma, alergias, pedido de vino…)' : 'Mensaje'}</label>
    <textarea id={id('mensaje')} name="mensaje" rows="4" required={!visita}></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
