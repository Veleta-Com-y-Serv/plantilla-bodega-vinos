---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /vinos/<slug>/.
// Diseño «etiqueta de bodega»: banda negra con migas y hero partido (título en serif, texto, precio y botones; a la
// derecha la botella con marco dorado o, sin foto, una botella dibujada del color del tipo); banda marfil con el
// `detalle` en párrafos y, al lado, la tabla de datos entre filetes dorados y la caja burdeos de pedido; fotos
// (`imagenes`) a sangre en banda negra; y otros vinos de la misma lista en banda burdeos.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import { seccion, site, tel, whatsapp, externo, clave } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const cta = seccion(f.idSeccion)?.cta;
const pedir = cta?.url || site.boton_cabecera?.url || enlace('/#contacto');
const textoPedir = cta?.texto || site.boton_cabecera?.texto || 'Pedir este vino';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
const tipo = clave(String(f.elemento.tipo ?? ''));
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--negro ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="ficha-hero">
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={pedir} {...(externo(pedir) && { rel: 'noopener', target: '_blank' })}>{textoPedir}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        <div class="ficha-foto" data-tipo={tipo}>
          {f.imagen ? (
            <Imagen src={f.imagen} alt={f.titulo} ancho={750} alto={1000} prioridad />
          ) : (
            <svg class="ficha-botella" viewBox="0 0 60 200" aria-hidden="true">
              <path d="M24 4h12v46c0 8 14 16 14 36v104a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6V86c0-20 14-28 14-36z" fill="currentColor" />
              <rect x="10" y="112" width="40" height="44" fill="none" stroke="var(--c-acento)" stroke-width="1.5" />
              <rect x="22" y="2" width="16" height="18" fill="var(--c-acento)" />
            </svg>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="banda banda--marfil">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En la etiqueta</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-dato-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-pedido">
          <p class="ficha-pedido-titulo">¿Te lo mandamos?</p>
          <p>Escríbenos y te decimos cómo recogerlo en la bodega o recibirlo en casa.</p>
          <a class="btn" href={pedir} {...(externo(pedir) && { rel: 'noopener', target: '_blank' })}>{textoPedir}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda--negro banda--sin-relleno" aria-label={`Fotos de ${f.titulo}`}>
      <ul class="ficha-galeria">
        {f.imagenes.map((src, i) => (
          <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--vino">
      <div class="contenedor">
        <div class="titular">
          <p class="antetitulo">{nombreSeccion}</p>
          <h2 class="titulo">Otros vinos de la casa</h2>
        </div>
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="ficha-otra-texto">{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-otra-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-14"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todos los vinos</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3.5rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .18em; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: ""; width: 5px; height: 5px; background: var(--c-acento); transform: rotate(45deg); }
  .migas a { color: var(--c-acento); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto { min-width: 0; }
  .ficha-hero-texto .titulo { font-size: clamp(2.5rem, 6.5vw, 5.5rem); overflow-wrap: anywhere; }
  .ficha-precio { margin-top: 1.5rem; font-family: var(--fuente-titulos); font-size: 2.25rem; color: var(--c-acento); font-variant-numeric: lining-nums tabular-nums; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a, .ficha-pedido .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { --tipo: var(--c-acento); position: relative; aspect-ratio: 3 / 4; max-width: 24rem; width: calc(100% - 16px); justify-self: center; overflow: hidden; border: 1px solid var(--filete-oro); outline: 1px solid var(--filete-oro); outline-offset: 8px; background: radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--tipo) 30%, var(--negro)), var(--negro) 72%); }
  .ficha-foto[data-tipo="tinto"] { --tipo: color-mix(in srgb, var(--c-primario) 75%, #fff 10%); }
  .ficha-foto[data-tipo="blanco"] { --tipo: #e8d898; }
  .ficha-foto[data-tipo="rosado"], .ficha-foto[data-tipo="clarete"] { --tipo: #e59a98; }
  .ficha-foto[data-tipo="espumoso"], .ficha-foto[data-tipo="cava"] { --tipo: color-mix(in srgb, var(--c-acento) 70%, #fff); }
  .ficha-foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ficha-botella { position: absolute; inset: 12% 0 6%; margin: auto; height: 82%; width: auto; color: var(--tipo); }
  .ficha-cuerpo { display: grid; gap: 3.5rem; }
  .ficha-detalle { max-width: 42rem; min-width: 0; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-family: var(--fuente-titulos); font-size: clamp(1.35rem, 2.4vw, 1.75rem); line-height: 1.3; color: var(--c-primario); }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; min-width: 0; }
  .ficha-lado-titulo { font-size: 1.6rem; color: var(--c-primario); margin-bottom: 1rem; }
  .ficha-datos { border-top: 2px solid var(--c-acento); border-bottom: 1px solid var(--filete-oro); padding-block: 1.5rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--filete-oro); }
  .ficha-datos dl > div:first-child { border-top: 0; }
  .ficha-datos dt { font-size: .68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .2em; opacity: .7; padding-top: .3rem; }
  .ficha-datos dd { text-align: right; min-width: 0; overflow-wrap: anywhere; font-weight: 600; }
  .ficha-dato-precio { font-family: var(--fuente-titulos); font-size: 1.45rem; color: var(--c-primario); }
  .ficha-pedido { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; background: var(--vino); color: var(--claro); border: 1px solid var(--c-acento); }
  .ficha-pedido-titulo { font-family: var(--fuente-titulos); font-size: 1.7rem; line-height: 1.1; color: var(--c-acento); }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 600; letter-spacing: .08em; color: var(--claro); text-decoration: none; }
  .ficha-tel:hover { color: var(--c-acento); }
  .ficha-galeria { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-galeria :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.75rem 1.5rem; border: 1px solid var(--filete-oro); transition: background-color .2s ease; }
  .ficha-otra:hover { background: var(--vino-oscuro); }
  .ficha-otra h3 { font-size: 1.6rem; overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 3px; }
  .ficha-otra-texto { font-size: .95rem; opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .75rem; }
  .ficha-otra-precio { font-family: var(--fuente-titulos); font-size: 1.45rem; color: var(--c-acento); }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .4rem; font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .2em; color: var(--c-acento); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 5rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 6rem; align-items: start; }
    .ficha-lado { position: sticky; top: 7rem; }
  }
</style>
