---
// Ejemplo de página adicional: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda banda--vino !pb-12 md:!pb-16">
    <div class="contenedor">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="titulo">Aviso legal y privacidad</h1>
    </div>
  </section>
  <section class="banda banda--marfil">
    <article class="contenedor texto-largo">
      <div class="max-w-3xl">
        <h2>Quiénes somos</h2>
        <p>
          Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
            c.email || 'nuestro correo de contacto'
          }{c.telefono && ` o llamarnos al ${c.telefono}`}.
        </p>
        <h2>Qué datos tratamos</h2>
        <p>
          Solo los que nos envías al escribirnos, al reservar una visita o al pedir vino: nombre, forma de contacto, el día
          y el número de personas de la visita y tu mensaje. Los usamos para responderte. No los cedemos a nadie salvo
          obligación legal.
        </p>
        <h2>Cuánto tiempo los guardamos</h2>
        <p>El necesario para atender tu consulta, tu visita o tu pedido y, después, el que marque la ley.</p>
        <h2>Tus derechos</h2>
        <p>
          Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
          puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
        </p>
        <h2>Venta de vino</h2>
        <p>{site.aviso_edad}</p>
        <h2>Cookies</h2>
        <p>Esta web no usa cookies de seguimiento.</p>
        <p class="mt-10"><a class="btn btn--vino" href="/">Volver al inicio</a></p>
      </div>
    </article>
  </section>
</Base>
