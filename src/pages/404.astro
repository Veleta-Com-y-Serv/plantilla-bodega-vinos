---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--negro">
    <div class="contenedor grid items-center gap-10 py-10 md:min-h-[60svh] lg:grid-cols-[6fr_6fr]">
      <p class="error-cifra" aria-hidden="true">404</p>
      <div class="titular !mb-0">
        <p class="antetitulo">Página no encontrada</p>
        <h1 class="titulo">Esta botella no está en la bodega</h1>
        <p class="titular-texto">Puede que el enlace esté mal o que la página se haya movido.</p>
        <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
      </div>
    </div>
  </section>
</Base>
